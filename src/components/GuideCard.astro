---
const { guide } = Astro.props;
const { data } = guide;
---
<a class={`guide-card ${data.petType}`} href={`/guides/${data.slug}/`}><div class="card-top"><span class="pet-badge">{data.petType === 'dog' ? '강아지' : '고양이'}</span><span class="category">{data.category}</span></div><h3>{data.title}</h3><p>{data.description}</p><span class="read">읽어보기 →</span></a>
<style>.guide-card{display:block;background:#fff;border:1px solid #e6ebe5;border-radius:20px;padding:22px;transition:transform .2s,box-shadow .2s}.guide-card:hover{transform:translateY(-3px);box-shadow:0 10px 26px #2f5d5110}.card-top{display:flex;justify-content:space-between;align-items:center;font-size:12px}.pet-badge{border-radius:99px;padding:5px 10px;background:#e1f1ed;color:#297c70}.cat .pet-badge{background:#fff0db;color:#b56c27}.category{color:#91a09b}.guide-card h3{font-size:18px;line-height:1.45;letter-spacing:-.04em;margin:20px 0 8px}.guide-card p{font-size:13px;line-height:1.7;color:#71807b;margin:0 0 22px}.read{font-size:13px;font-weight:700;color:#3b7c70}</style>
