---
const { title = 'emfls pet', description = `emfls pet의 ${title} 페이지 — 강아지와 고양이의 반려생활 가이드`, canonical } = Astro.props;
const url = canonical ?? Astro.url.href;
const isProduction = import.meta.env.PROD;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={url} />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="emfls pet" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={url} />
    <link rel="icon" href="/favicon.svg" />
    {isProduction && <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DS3JXX4VR6"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-DS3JXX4VR6');
      </script>
    </>}
  </head>
  <body><header class="site-header"><a class="brand" href="/" aria-label="emfls pet 홈"><span class="brand-mark">⌂</span><span>emfls <strong>pet</strong></span></a><nav aria-label="주요 메뉴"><a href="/dog/">강아지</a><a href="/cat/">고양이</a><a href="/guides/">가이드</a><a href="/about/">소개</a></nav></header><main><slot /></main><footer><div><strong>emfls pet</strong><p>매일의 반려생활을 조금 더 다정하게.</p></div><div class="footer-links"><a href="/tools/routine/">Pet Routine</a><a href="/tools/feeding/">급여량 참고</a><a href="/editorial-policy/">콘텐츠 정책</a><a href="/privacy/">개인정보처리방침</a><a href="/contact/">문의</a></div></footer></body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700;800&display=swap');
:root{font-family:'Noto Sans KR','DM Sans',sans-serif;color:#243331;background:#fbfaf6;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.site-header{height:76px;display:flex;align-items:center;justify-content:space-between;max-width:1160px;margin:auto;padding:0 24px}.brand{display:flex;gap:9px;align-items:center;font-size:19px;font-weight:700;letter-spacing:-.04em}.brand strong{color:#e67358}.brand-mark{display:grid;place-items:center;background:#d9eee9;color:#24796e;border-radius:12px;width:32px;height:32px;font-size:20px}nav{display:flex;gap:26px;color:#5c6c68;font-size:14px}nav a:hover,.footer-links a:hover{color:#e67358}main{max-width:1160px;margin:auto;padding:0 24px 80px}footer{border-top:1px solid #e4e8e2;max-width:1112px;margin:0 auto;padding:30px 24px 48px;display:flex;justify-content:space-between;color:#74817d;font-size:13px}footer strong{color:#243331;font-size:16px}.footer-links{display:flex;gap:18px;align-items:center}@media(max-width:640px){.site-header{height:68px}nav{gap:13px;font-size:12px}.brand{font-size:16px}main{padding:0 16px 56px}footer{display:block}.footer-links{margin-top:20px}}
</style>
