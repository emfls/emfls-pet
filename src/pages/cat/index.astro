---
import Layout from '../../layouts/Layout.astro'; import GuideCard from '../../components/GuideCard.astro'; import { getCollection } from 'astro:content'; const guides=(await getCollection('guides')).filter(g=>g.data.petType==='cat');
---
<Layout title="고양이 생활 가이드 — emfls pet"><div class="pet-page cat"><span class="eyebrow">CAT LIFE</span><h1>고양이의 신호를 읽고<br /><em>생활을 맞춰가요.</em></h1><p>물, 화장실, 이동장까지 고양이의 속도로.</p><div class="hub-links"><a href="/guides/">전체 가이드 보기 →</a><a href="/tools/routine/">오늘 루틴 체크 →</a></div></div><h2>고양이 가이드</h2><div class="guide-grid">{guides.map((guide)=><GuideCard guide={guide}/>)}</div></Layout>
<style>.pet-page{padding:58px 0 42px}.pet-page h1{font-size:42px;line-height:1.25;letter-spacing:-.08em;margin:15px 0}.pet-page em{font-style:normal;color:#d27c35}.pet-page p{color:#6d7d77}.hub-links{display:flex;gap:12px;margin-top:22px;flex-wrap:wrap}.hub-links a{background:#fff1df;color:#a9652a;padding:10px 13px;border-radius:10px;font-size:12px;font-weight:700}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}h2{font-size:25px;letter-spacing:-.06em}@media(max-width:700px){.pet-page{padding:40px 0 26px}.pet-page h1{font-size:33px}.guide-grid{grid-template-columns:1fr}}</style>
