---
import Layout from '../../layouts/Layout.astro'; import GuideCard from '../../components/GuideCard.astro'; import { getCollection, render } from 'astro:content'; export async function getStaticPaths(){const guides=await getCollection('guides'); return guides.map((guide)=>({params:{slug:guide.data.slug},props:{guide,guides}}));} const {guide,guides}=Astro.props; const {Content}=await render(guide); const d=guide.data; const explicit=d.relatedGuides.map((slug)=>guides.find((item)=>item.data.slug===slug)).filter(Boolean); const related=explicit.length?explicit.slice(0,3):guides.filter((item)=>item.data.slug!==d.slug&&item.data.petType===d.petType&&item.data.category===d.category).slice(0,3); const siteUrl=Astro.site?.toString().replace(/\/$/,'')??'https://pet.emfls.com'; const pageUrl=`${siteUrl}/guides/${d.slug}/`; const jsonLd={ '@context':'https://schema.org', '@graph':[{ '@type':'Article',headline:d.title,description:d.description,dateModified:d.updated.toISOString(),mainEntityOfPage:pageUrl},{ '@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'홈',item:`${siteUrl}/`},{ '@type':'ListItem',position:2,name:'가이드',item:`${siteUrl}/guides/`},{ '@type':'ListItem',position:3,name:d.title,item:pageUrl}]}]};
---
<Layout title={`${d.title} — emfls pet`} description={d.description} canonical={pageUrl} jsonLd={jsonLd}><article class="guide-detail"><a class="back" href="/guides/">← 모든 가이드</a><div class="detail-meta"><span class="pet-badge">{d.petType==='dog'?'강아지':'고양이'}</span><span>{d.category} · {d.updated.toLocaleDateString('ko-KR')}</span></div><h1>{d.title}</h1><p class="lead">{d.description}</p><div class="notice"><strong>한눈에 보기</strong><p>{d.summary}</p></div><div class="prose"><Content /></div>{related.length > 0 && <section class="related" aria-labelledby="related-title"><h2 id="related-title">다음으로 읽어볼 가이드</h2><div class="related-grid">{related.map((item)=><GuideCard guide={item}/>)}</div></section>}<a class="back" href="/guides/">← 다른 가이드도 살펴보기</a></article></Layout>
<style>.guide-detail{max-width:720px;margin:auto;padding:54px 0}.back{font-size:13px;color:#4a756d;font-weight:700}.detail-meta{display:flex;gap:12px;align-items:center;color:#89958f;font-size:12px;margin-top:40px}.pet-badge{border-radius:99px;padding:5px 10px;background:#e1f1ed;color:#297c70}.guide-detail h1{font-size:clamp(30px,5vw,47px);letter-spacing:-.075em;line-height:1.25;margin:20px 0 12px}.lead{font-size:17px;line-height:1.8;color:#6d7d77}.notice{background:#eaf3ee;border-radius:18px;padding:20px 22px;margin:35px 0}.notice strong{font-size:13px;color:#297c70}.notice p{font-size:14px;line-height:1.7;margin:9px 0 0}.prose{font-size:16px;line-height:2;color:#42534e}.prose :global(h2){font-size:22px;letter-spacing:-.05em;color:#243331;margin:38px 0 10px}.prose :global(ul){padding-left:20px}.prose :global(li){margin:6px 0}.prose :global(strong){color:#287c70}.related{border-top:1px solid #e4ebe5;margin:48px 0 32px;padding-top:32px}.related h2{font-size:22px;letter-spacing:-.05em;margin:0 0 18px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}@media(max-width:700px){.related-grid{grid-template-columns:1fr}}</style>
