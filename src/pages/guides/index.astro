---
import Layout from '../../layouts/Layout.astro'; import { getCollection } from 'astro:content'; const guides = await getCollection('guides');
---
<Layout title="반려생활 가이드 — emfls pet"><div class="page-intro"><span class="eyebrow">GUIDE LIBRARY</span><h1>필요한 답을,<br /><em>차분하게 찾아보세요.</em></h1><p>반려생활에서 자주 마주치는 질문을 짧고 실용적으로 정리했어요.</p></div><section class="guide-explorer" aria-labelledby="explorer-title"><h2 id="explorer-title">가이드 찾기</h2><div class="controls"><label class="search-label" for="guide-search">검색어 <input id="guide-search" type="search" aria-label="제목, 설명, 태그로 가이드 검색" autocomplete="off" /></label><label for="pet-filter">반려동물<select id="pet-filter"><option value="all">전체</option><option value="dog">강아지</option><option value="cat">고양이</option></select></label><label for="category-filter">주제<select id="category-filter"><option value="all">전체 주제</option>{['먹이','행동','생활','용품','훈련','놀이','위생','입양/준비'].map(c=><option value={c}>{c}</option>)}</select></label><button id="reset-filters" type="button">초기화</button></div><p id="result-count" class="result-count" aria-live="polite"></p><div id="guide-results" class="guide-grid">{guides.map((guide) => <article class="guide-result" data-search={`${guide.data.title} ${guide.data.description} ${guide.data.tags.join(' ')}`} data-pet={guide.data.petType} data-category={guide.data.category}><a class={`guide-card ${guide.data.petType}`} href={`/guides/${guide.data.slug}/`}><div class="card-top"><span class="pet-badge">{guide.data.petType === 'dog' ? '강아지' : '고양이'}</span><span class="category">{guide.data.category}</span></div><h3>{guide.data.title}</h3><p>{guide.data.description}</p><span class="read">읽어보기 →</span></a></article>)}</div><div id="no-results" class="no-results" hidden><strong>조건에 맞는 가이드가 없어요.</strong><p>검색어를 지우거나 필터를 초기화해 보세요.</p></div></section></Layout>
<script>
const search = document.querySelector<HTMLInputElement>('#guide-search')!; const pet = document.querySelector<HTMLSelectElement>('#pet-filter')!; const category = document.querySelector<HTMLSelectElement>('#category-filter')!; const reset = document.querySelector<HTMLButtonElement>('#reset-filters')!; const count = document.querySelector<HTMLElement>('#result-count')!; const empty = document.querySelector<HTMLElement>('#no-results')!;
const update = () => { const query = search.value.trim().toLowerCase(); const items = [...document.querySelectorAll<HTMLElement>('.guide-result')]; let visible = 0; items.forEach((item) => { const match = (!query || (item.dataset.search ?? '').toLowerCase().includes(query)) && (pet.value === 'all' || item.dataset.pet === pet.value) && (category.value === 'all' || item.dataset.category === category.value); item.hidden = !match; if (match) visible++; }); count.textContent = `${visible}개의 가이드`; empty.hidden = visible !== 0; };
[search, pet, category].forEach((control) => control.addEventListener('input', update)); reset.addEventListener('click', () => { search.value = ''; pet.value = 'all'; category.value = 'all'; update(); search.focus(); }); update();
</script>
<style>.page-intro{padding:65px 0 38px}.page-intro h1{font-size:44px;line-height:1.2;letter-spacing:-.08em;margin:16px 0}.page-intro em{font-style:normal;color:#328a7c}.page-intro p{color:#6d7d77}.guide-explorer h2{font-size:22px;letter-spacing:-.05em}.controls{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end;background:#fff;border:1px solid #e6ebe5;border-radius:18px;padding:16px}.controls label{display:grid;gap:7px;font-size:12px;color:#65756f;font-weight:700}.controls input,.controls select{width:100%;height:44px;border:1px solid #dce5df;border-radius:10px;background:#fbfcfa;color:#243331;padding:0 12px;font:inherit;font-weight:400;outline:none}.controls input:focus,.controls select:focus{border-color:#287c70;box-shadow:0 0 0 3px #287c7024}.controls button,.controls>button{height:44px;padding:0 15px;border:0;border-radius:10px;background:#eaf3ee;color:#287c70;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.result-count{font-size:13px;color:#687872;margin:18px 0 12px}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.guide-result[hidden]{display:none}.no-results{text-align:center;background:#fff;border:1px dashed #cbdad2;border-radius:18px;padding:42px 20px;color:#6d7d77}.no-results strong{color:#243331}.no-results p{font-size:13px}@media(max-width:700px){.page-intro{padding:40px 0 25px}.page-intro h1{font-size:34px}.controls{grid-template-columns:1fr 1fr}.search-label{grid-column:1/-1}.controls button{grid-column:1/-1}.guide-grid{grid-template-columns:1fr}}</style>
