---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const featuredSlugs = ['dog-not-eating', 'cat-not-drinking', 'dog-walk-checklist', 'cat-litter-care', 'dog-bath', 'cat-carrier-adaptation'];
const featuredGuides = featuredSlugs.map((slug) => guides.find((guide) => guide.data.slug === slug)).filter(Boolean);
---

<Layout title="emfls pet — 반려생활 가이드">
  <section class="hero"><div><span class="eyebrow">PET LIFE, MADE SIMPLE</span><h1>반려동물과의 하루,<br /><em>조금 더 편안하게.</em></h1><p>먹이부터 행동, 생활환경까지. 처음 만나는 문제에도 차분히 답하는 반려생활 가이드.</p><div class="hero-actions"><a class="button primary" href="/guides/">가이드 둘러보기 <span>→</span></a><a class="text-link" href="/dog/">강아지부터 보기</a></div></div><div class="hero-art" aria-label="강아지와 고양이를 상징하는 일러스트" role="img"><span class="sun"></span><span class="blob blob-one"></span><span class="blob blob-two"></span><span class="pet-doodle">🐕</span><span class="pet-doodle cat-doodle">🐈</span></div></section>
  <section class="quick"><div class="section-heading"><div><span class="eyebrow">START HERE</span><h2>누구와 함께 살고 있나요?</h2></div><span class="heading-note">맞춤 가이드로 바로 이동해요</span></div><div class="pet-choices"><a class="pet-choice dog-choice" href="/dog/"><span class="choice-icon">🐕</span><div><strong>강아지와 살아요</strong><small>식사 · 산책 · 훈련</small></div><span>→</span></a><a class="pet-choice cat-choice" href="/cat/"><span class="choice-icon">🐈</span><div><strong>고양이와 살아요</strong><small>물 · 화장실 · 적응</small></div><span>→</span></a></div></section>
  <section><div class="section-heading"><div><span class="eyebrow">COMMON QUESTIONS</span><h2>자주 찾는 반려생활 문제</h2></div><a class="text-link" href="/guides/">모두 보기 →</a></div><div class="guide-grid">{featuredGuides.map((guide) => <GuideCard guide={guide} />)}</div></section>
  <section class="feature-grid"><a class="routine" href="/tools/routine/"><span class="eyebrow">TODAY</span><h2>Pet Routine</h2><p>우리 아이의 식사, 산책, 놀이를 한눈에 챙기는 하루 루틴.</p><span class="feature-tag">오늘 체크하기 →</span></a><a class="calculator" href="/tools/feeding/"><span class="eyebrow">REFERENCE</span><h2>급여량 참고 계산기</h2><p>제품 표시 권장량을 실제 급여 횟수에 맞춰 나누어 보는 생활 참고 도구.</p><span class="feature-tag">계산해 보기 →</span></a></section>
</Layout>
<style>.hero{min-height:480px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:30px;padding:52px 28px}.eyebrow{font-size:11px;letter-spacing:.13em;color:#e67358;font-weight:800}.hero h1{font-size:clamp(36px,5vw,62px);line-height:1.16;letter-spacing:-.04em;margin:18px 0}.hero h1 em{font-style:normal;color:#328a7c}.hero p{color:#6d7d77;line-height:1.9;font-size:16px;max-width:34rem}.hero-actions{display:flex;align-items:center;gap:24px;margin-top:28px}.button{padding:14px 19px;border-radius:12px;font-size:14px;font-weight:700}.primary{background:#287c70;color:#fff;box-shadow:0 8px 18px #287c7026}.primary span{margin-left:12px}.text-link{font-size:13px;font-weight:700;color:#4a756d}.hero-art{height:340px;position:relative;background:#e8f2ec;border-radius:42% 42% 36% 40%;overflow:hidden}.sun{position:absolute;width:180px;height:180px;border-radius:50%;background:#f4c77e;top:33px;right:40px}.blob{position:absolute;border-radius:50%;background:#c1e1d5}.blob-one{width:220px;height:170px;bottom:-50px;left:10px}.blob-two{width:160px;height:160px;right:-30px;bottom:-30px;background:#f4d1a4}.pet-doodle{position:absolute;left:22%;top:31%;font-size:92px;filter:drop-shadow(0 8px 5px #26695b18);transform:rotate(-6deg)}.cat-doodle{left:auto;right:18%;top:48%;font-size:76px;transform:rotate(8deg)}section{margin-top:54px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:22px}.section-heading h2{margin:8px 0 0;font-size:26px;letter-spacing:-.04em}.heading-note{font-size:12px;color:#91a09b}.pet-choices{display:grid;grid-template-columns:1fr 1fr;gap:16px}.pet-choice{display:flex;align-items:center;gap:16px;padding:21px 22px;border-radius:18px;border:1px solid transparent}.pet-choice>div{display:grid;gap:5px;flex:1}.pet-choice strong{font-size:16px}.pet-choice small{font-size:12px;color:#71807b}.dog-choice{background:#e6f2ed;border-color:#d7eae1}.cat-choice{background:#fff1df;border-color:#f8e5c8}.choice-icon{font-size:37px}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.feature-grid a{padding:30px;border-radius:22px;min-height:190px}.feature-grid h2{margin:14px 0 7px;font-size:23px;letter-spacing:-.04em}.feature-grid p{line-height:1.7;color:#64736e;font-size:14px}.routine{background:#dceee7}.calculator{background:#f8e7d0}.feature-tag{display:inline-block;margin-top:8px;padding:6px 10px;border-radius:99px;background:#ffffff80;color:#6a7973;font-size:11px}@media(max-width:700px){.hero{grid-template-columns:1fr;padding:36px 6px 10px;min-height:auto}.hero-art{height:220px;border-radius:30px}.pet-doodle{font-size:65px}.cat-doodle{font-size:54px}.section-heading{align-items:start;gap:12px}.section-heading h2{font-size:21px}.heading-note{display:none}.guide-grid,.feature-grid{grid-template-columns:1fr}.pet-choices{grid-template-columns:1fr}.hero-actions{gap:15px;flex-wrap:wrap}}
</style>
<style>
@media (max-width: 700px) {
  .hero > div { min-width: 0; }
  .hero p { overflow-wrap: anywhere; }
}
</style>
