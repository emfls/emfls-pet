---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Pet Routine — 오늘의 반려생활 체크리스트" description="오늘의 급여, 물, 산책, 놀이와 위생 관리를 간단히 체크하는 Pet Routine입니다."><div class="tool-head"><a href="/tools/">← 반려생활 도구</a><span class="eyebrow">PET ROUTINE</span><h1>오늘 우리 아이를<br /><em>잘 돌봤나요?</em></h1><p>오늘의 기본 루틴을 체크하고 가볍게 마무리해요.</p></div><section class="routine-box" aria-labelledby="routine-title"><div class="progress-row"><div><h2 id="routine-title">오늘의 루틴</h2><p id="routine-date"></p></div><strong id="progress">0 / 5</strong></div><div id="routine-list" class="routine-list"></div><div class="routine-actions"><button id="routine-reset" type="button">오늘 기록 초기화</button><span id="routine-status" aria-live="polite"></span></div></section></Layout>
<script>
type RoutineState = { date: string; done: Record<string, boolean> }; const tasks = [{id:'feeding',label:'급여',detail:'오늘의 식사를 챙겼어요'},{id:'water',label:'물',detail:'신선한 물을 준비했어요'},{id:'walk',label:'산책',detail:'가볍게 바깥 공기를 쐈어요'},{id:'play',label:'놀이',detail:'함께 놀거나 교감했어요'},{id:'care',label:'위생 · 관리',detail:'발·털·화장실을 살폈어요'}]; const key='emfls-pet-routine'; const localDate=()=>{const date=new Date(); return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;}; const today=localDate(); let state: RoutineState={date:today,done:{}}; try { const saved=JSON.parse(localStorage.getItem(key) ?? 'null') as RoutineState | null; if(saved?.date===today) state=saved; } catch {}
const list=document.querySelector<HTMLElement>('#routine-list')!; const progress=document.querySelector<HTMLElement>('#progress')!; const status=document.querySelector<HTMLElement>('#routine-status')!; document.querySelector<HTMLElement>('#routine-date')!.textContent=new Date().toLocaleDateString('ko-KR',{month:'long',day:'numeric',weekday:'short'});
const save=()=>localStorage.setItem(key,JSON.stringify(state)); const render=()=>{list.innerHTML=tasks.map((task)=>`<label class="routine-item ${state.done[task.id]?'is-done':''}"><input type="checkbox" data-id="${task.id}" ${state.done[task.id]?'checked':''}><span class="checkmark" aria-hidden="true">✓</span><span><strong>${task.label}</strong><small>${task.detail}</small></span></label>`).join(''); const complete=tasks.filter((task)=>state.done[task.id]).length; progress.textContent=`${complete} / ${tasks.length}`; status.textContent=complete===tasks.length?'오늘 루틴을 모두 챙겼어요.':''; list.querySelectorAll<HTMLInputElement>('input').forEach((input)=>input.addEventListener('change',()=>{const id=input.dataset.id; if(id) state.done[id]=input.checked; save(); render();}));}; document.querySelector<HTMLButtonElement>('#routine-reset')!.addEventListener('click',()=>{state={date:today,done:{}}; save(); render();}); render();
</script>
<style>.tool-head{padding:44px 0 34px}.tool-head>a{font-size:13px;color:#4a756d;font-weight:700}.tool-head .eyebrow{display:block;margin-top:40px}.tool-head h1{font-size:42px;line-height:1.25;letter-spacing:-.08em;margin:15px 0 10px}.tool-head em{font-style:normal;color:#328a7c}.tool-head p{color:#6d7d77}.routine-box{max-width:720px;background:#fff;border:1px solid #e4ebe5;border-radius:24px;padding:25px;box-shadow:0 12px 28px #2f5d5109}.progress-row{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edf0eb;padding-bottom:20px}.progress-row h2{font-size:21px;margin:0;letter-spacing:-.05em}.progress-row p{font-size:12px;color:#89958f;margin:6px 0 0}.progress-row strong{font-size:18px;color:#287c70}.routine-list{display:grid;gap:10px;padding:20px 0}.routine-item{display:flex;align-items:center;gap:13px;min-height:64px;padding:11px 13px;border:1px solid #e4ebe5;border-radius:14px;cursor:pointer}.routine-item input{position:absolute;opacity:0}.checkmark{display:grid;place-items:center;width:28px;height:28px;border:2px solid #c9d8d0;border-radius:9px;color:transparent;font-weight:800}.routine-item span:last-child{display:grid;gap:4px}.routine-item small{font-size:12px;color:#83908b}.routine-item.is-done{background:#eaf3ee;border-color:#c7e3d9}.routine-item.is-done .checkmark{background:#287c70;border-color:#287c70;color:#fff}.routine-item.is-done strong{color:#287c70}.routine-item:focus-within{outline:3px solid #287c7024}.routine-actions{display:flex;align-items:center;gap:15px}.routine-actions button{border:0;background:transparent;color:#e67358;font:inherit;font-size:12px;font-weight:700;padding:10px 0;cursor:pointer}.routine-actions span{font-size:12px;color:#287c70}@media(max-width:640px){.tool-head{padding:35px 0 25px}.tool-head h1{font-size:33px}.routine-box{padding:18px;border-radius:20px}}</style>
